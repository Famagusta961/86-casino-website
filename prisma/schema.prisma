generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model SiteSetting {
  id          String   @id @default("site")
  casinoName  String   @default("86 CASINO")
  title       String   @default("86 Casino | Accra's destination for gaming & entertainment")
  description String  @default("Luxury gaming, exceptional hospitality and unforgettable nights in Accra.")
  logo        String?
  phone       String   @default("+233 30 000 0086")
  email       String   @default("hello@86casino.com")
  address     String   @default("Accra, Ghana")
  directions  String   @default("https://maps.google.com/?q=Accra,Ghana")
  hours       String   @default("Open daily · 12:00 - late")
  instagram   String?
  facebook    String?
  twitter     String?
  youtube     String?
  copyright   String   @default("© 2026 86 CASINO. All rights reserved.")
  ageNotice   String   @default("18+ only. Please gamble responsibly.")
  updatedAt   DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  eyebrow     String?
  intro       String?
  body        String?
  heroImage   String?
  seoTitle    String?
  seoDescription String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Game {
  id String @id @default(cuid())
  name String
  subtitle String
  description String
  image String
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id String @id @default(cuid())
  title String
  subtitle String
  description String
  image String
  terms String?
  startDate DateTime?
  endDate DateTime?
  featured Boolean @default(false)
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())
  title String
  subtitle String
  description String
  image String
  dateTime DateTime
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id String @id @default(cuid())
  image String
  altText String
  category String
  caption String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  phone String?
  subject String?
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}